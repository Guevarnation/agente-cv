# Modelo: "<proveedor>:<modelo>". Con mock:echo el agente arranca sin ninguna clave.
AGENT_MODEL=anthropic:claude-sonnet-5
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# Token que la plataforma envia como "Authorization: Bearer". Generar con: openssl rand -base64 32
AGENT_API_KEY=

PORT=3000
LOG_LEVEL=info
RATE_LIMIT_RPM=30
TURN_TIMEOUT_MS=90000
# EVAL_JUDGE_MODEL=anthropic:claude-haiku-4-5
