{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "files": { "includes": ["src/**", "tests/**", "evals/run.ts", "*.json"] },
  "formatter": { "indentStyle": "space", "lineWidth": 120 },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": { "noExplicitAny": "off" },
      "style": { "noNonNullAssertion": "off" }
    }
  }
}
